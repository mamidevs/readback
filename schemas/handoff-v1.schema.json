{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:readback:handoff:1",
  "title": "Readback 0.7 draft handoff v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "record_uid": {
      "type": "string",
      "pattern": "^rb:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}:HND:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^HND-[0-9]{8}-[0-9]{2,}$"
    },
    "from": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "state": {
      "enum": [
        "DONE",
        "PARTIAL",
        "BLOCKED",
        "UNABLE"
      ]
    },
    "readback": {
      "type": "object",
      "properties": {
        "task": {
          "type": "string",
          "minLength": 1
        },
        "limits": {
          "type": "string",
          "minLength": 1
        },
        "done_when": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "task",
        "limits",
        "done_when"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "minLength": 1
          },
          "change": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "file",
          "change"
        ],
        "additionalProperties": false
      }
    },
    "commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "command": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          },
          "exit": {
            "type": [
              "integer",
              "null"
            ]
          },
          "observation": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "command",
          "exit",
          "observation"
        ],
        "additionalProperties": false
      }
    },
    "contract": {
      "oneOf": [
        {
          "const": "none"
        },
        {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            "^ACC-[1-9][0-9]*$": {
              "type": "object",
              "properties": {
                "status": {
                  "enum": [
                    "VERIFIED",
                    "FAILED",
                    "UNVERIFIED"
                  ]
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "status",
                "evidence"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "open": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "severity": {
            "enum": [
              "blocking",
              "high",
              "low"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "severity",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "next": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object",
      "maxProperties": 1,
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "record_uid",
    "id",
    "from",
    "date",
    "state",
    "readback",
    "summary",
    "changes",
    "commit",
    "checks",
    "contract",
    "open",
    "issues",
    "next",
    "extensions"
  ],
  "additionalProperties": false,
  "description": "Draft shape only; W1 does not load or enforce this record schema. English core text, truthful statuses, namespace policy and project/record UUID equality need future semantic validation."
}
